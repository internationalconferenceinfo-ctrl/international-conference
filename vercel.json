{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
  {
    "source": "/api/:path*",
    "destination": "/api"
  },
  {
    "source": "/sitemap.xml",
    "destination": "/api"
  },
  {
    "source": "/robots.txt",
    "destination": "/api"
  },
  {
    "source": "/:path*",
    "destination": "/index.html"
  }
]
}