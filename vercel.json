{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**"
    }
  },
  "redirects": [
  {
    "source": "/home",
    "destination": "/",
    "permanent": true
  }
],
  "rewrites": [
  {
    "source": "/api/:path*",
    "destination": "/api"
  },
{
  "source": "/sitemaps.xml",
  "destination": "/api"
},
{
  "source": "/sitemap.xml",
  "destination": "/api"
},
  {
    "source": "/robots.txt",
    "destination": "/api"
  },
  {
  "source": "/:path*",
  "destination": "/api"
  }
]
}